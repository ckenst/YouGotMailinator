GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password
# Optional: email address to receive Contact Us form submissions (defaults to GMAIL_USER)
CONTACT_NOTIFY_EMAIL=your-notify-email@example.com

# Mailinator SDK — required for Playwright e2e email tests
# Get your API token at https://www.mailinator.com/
MAILINATOR_API_TOKEN=your-mailinator-api-token
# The Mailinator private domain to use for test inboxes (leave blank for public mailinator.com)
MAILINATOR_DOMAIN=your-private-domain.mailinator.com
